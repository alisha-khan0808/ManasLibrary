# ---------------------------------------------------------------------------
# Manas Library Management System — environment template
# Copy to .env (root), apps/api/.env and apps/web/.env.local as appropriate.
# NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# --- Frontend (browser-exposed; safe to ship) ------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Backend: Supabase ------------------------------------------------------
SUPABASE_URL=
# Server-only. Grants full admin rights. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Only needed for projects still using the legacy HS256 shared secret.
# When empty the API verifies tokens against the project's public JWKS endpoint.
SUPABASE_JWT_SECRET=

# --- Backend: database ------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string (URI).
# Use the pooled connection string in production.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# --- Backend: server --------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# --- Background jobs --------------------------------------------------------
# Set to false on replicas so scheduled jobs only run on one instance.
JOBS_ENABLED=true
JOB_FEE_REMINDERS_CRON=0 8 * * *
JOB_MEMBERSHIP_EXPIRY_CRON=15 0 * * *
JOB_BIOMETRIC_SYNC_CRON=*/15 * * * *

# --- Fee reminder notifications --------------------------------------------
# Provider-independent. Supported: none | log | webhook
NOTIFICATION_PROVIDER=log
NOTIFICATION_API_URL=
NOTIFICATION_API_KEY=

# --- Biometric attendance ---------------------------------------------------
# Supported: none | http
# `http` speaks a generic JSON contract documented in
# docs/BIOMETRIC_INTEGRATION.md. Configure only once the real device
# API/SDK is known — do not guess a vendor protocol.
BIOMETRIC_PROVIDER=none
BIOMETRIC_API_URL=
BIOMETRIC_API_KEY=
